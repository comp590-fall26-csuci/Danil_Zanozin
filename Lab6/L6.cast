[575.918029, "o", "\u001b[77;19H\u001b(B\u001b[0;7m^O\u001b(B\u001b[m Write Out\u001b[37G\u001b(B\u001b[0;7m^W\u001b(B\u001b[m Where Is\u001b[55G\u001b(B\u001b[0;7m^K\u001b(B\u001b[m Cut\u001b[77;73H\u001b(B\u001b[0;7m^T\u001b(B\u001b[m Execute\u001b[77;91H"]
[575.918062, "o", "\u001b(B\u001b[0;7m^C\u001b(B\u001b[m Location       \u001b(B\u001b[0;7mM-U\u001b(B\u001b[m Undo\u001b[77;127H\u001b(B\u001b[0;7mM-A\u001b(B\u001b[m Set Mark\u001b[145G\u001b(B\u001b[0;7mM-]\u001b(B\u001b[m To Bracket    \u001b(B\u001b[0;7mM-Q\u001b(B\u001b[m Previous\u001b[181G\u001b(B\u001b[0;7m^B\u001b(B\u001b[m Back   \u001b[77;199H\u001b(B\u001b[0;7m^◂\u001b(B\u001b[m Prev Word\u001b[217G\u001b(B\u001b[0;7m^A\u001b(B\u001b[m Home\u001b[77;235H\u001b(B\u001b[0;7m^P\u001b(B\u001b[m Prev Line\u001b[253G\u001b(B\u001b[0;7mM-▴\u001b(B\u001b[m Scroll Up     \u001b(B\u001b[0;7m^▴\u001b(B\u001b[m Prev Block     \u001b(B\u001b[0;7mM-(\u001b(B\u001b[m Begin of Parag\u001b(B\u001b[0;7m^Y\u001b(B\u001b[m Prev Page\u001b[325G\u001b(B\u001b[0;7mM-\\\u001b(B\u001b[m First Line    \u001b(B\u001b[0;7mM-◂\u001b(B\u001b[m Prev File\u001b[78;2H\u001b(B\u001b[0;7mX\u001b(B\u001b[m Exit  \u001b[78;19H"]
[575.918096, "o", "\u001b(B\u001b[0;7m^R\u001b(B\u001b[m Read File\u001b[37G\u001b(B\u001b[0;7m^\\\u001b(B\u001b[m Replace\u001b[78;55H\u001b(B\u001b[0;7m^U\u001b(B\u001b[m Paste\u001b[78;73H\u001b(B\u001b[0;7m^J\u001b(B\u001b[m Justify\u001b[78;91H\u001b(B\u001b[0;7m^/\u001b(B\u001b[m Go To Line     \u001b(B\u001b[0;7mM-E\u001b(B\u001b[m Redo\u001b[78;127H\u001b(B\u001b[0;7mM-6\u001b(B\u001b[m Copy\u001b[78;145H\u001b(B\u001b[0;7m^Q\u001b(B\u001b[m Where Was\u001b[163G\u001b(B\u001b[0;7mM-W\u001b(B\u001b[m Next\u001b[78;181H\u001b(B\u001b[0;7m^F\u001b(B\u001b[m Forward \u001b[199G\u001b(B\u001b[0;7m^▸\u001b(B\u001b[m Next Word\u001b[217G"]
