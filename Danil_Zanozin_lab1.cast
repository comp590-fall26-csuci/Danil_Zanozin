[0.001, "o", "\u001b[1;1H\u001b[J\u001b[7m  UW PICO 5.09                                                                          File: lab1.py                                                                            \u001b[27m\u001b[3;1H\"\"\"Write the first 25 Fibonacci numbers to a file, computed iteratively.\"\"\"\u001b[5;1Hfrom pathlib import Path\u001b[7;1HOUTPUT_DIR = Path(__file__).resolve().parent / \"output\"\u001b[8;1HOUTPUT_FILE = \"fibonacci_recursive_output.txt\"\u001b[11;1Hdef fib_sequence(count):\u001b[12;5H\"\"\"Return the first `count` Fibonacci numbers, built with a loop.\"\"\"\u001b[13;5Hdef fib(n):\u001b[14;9Hif n < 2:\u001b[15;13Hreturn n\u001b[16;9Hreturn fib(n - 1) + fib(n - 2)\u001b[17;5Hreturn [fib(n) for n in range(count)]\u001b[21;1Hdef fibonacci(count=25, filename=OUTPUT_FILE):\u001b[22;5H\"\"\"Write `count` Fibonacci numbers to `filename` in the output directory.\"\"\"\u001b[23;5Hsequence = fib_sequence(count)\u001b[25;5HOUTPUT_DIR.mkdir(exist_ok=True)\u001b[26;5Hpath = OUTPUT_DIR / filename\u001b[27;5Hwith open(path, \"w\") as f:\u001b[28;9Hfor index, value in enumerate(sequence):\u001b[29;13Hf.write(f\"F({index}) = {value}\\n\")"]
[0.000, "o", "\u001b[31;5Hprint(f\"Wrote {count} Fibonacci numbers to {path}\")\u001b[32;5Hreturn sequence\u001b[35;1Hif __name__ == \"__main__\":\u001b[36;5Hfibonacci()\u001b[78;1H\u001b[K\u001b[79;1H\u001b[K\u001b[78;1H\u001b[7m^\u001b[27m\u001b[7mG\u001b[27m Get Help                  \u001b[7m^\u001b[27m\u001b[7mO\u001b[27m WriteOut                  \u001b[7m^\u001b[27m\u001b[7mR\u001b[27m Read File                 \u001b[7m^\u001b[27m\u001b[7mY\u001b[27m Prev Pg                   \u001b[7m^\u001b[27m\u001b[7mK\u001b[27m Cut Text                  \u001b[7m^\u001b[27m\u001b[7mC\u001b[27m Cur Pos                   \u001b[K"]
[0.000, "o", "\u001b[79;1H\u001b[7m^\u001b[27m\u001b[7mX\u001b[27m Exit                      \u001b[7m^\u001b[27m\u001b[7mJ\u001b[27m Justify                   \u001b[7m^\u001b[27m\u001b[7mW\u001b[27m Where is                  \u001b[7m^\u001b[27m\u001b[7mV\u001b[27m Next Pg                   \u001b[7m^\u001b[27m\u001b[7mU\u001b[27m UnCut Text                \u001b[7m^\u001b[27m\u001b[7mT\u001b[27m To Spell                  \u001b[K\u001b[3;1H"]
