[0.000, "o", "\u001b[1;1H\u001b[J\u001b[7m  UW PICO 5.09                                                                          File: lab1.py                                                                            \u001b[27m\u001b[3;1H\"\"\"Write the first 25 Fibonacci numbers to a file, computed iteratively.\"\"\"\u001b[5;1Hfrom pathlib import Path\u001b[7;1HOUTPUT_DIR = Path(__file__).resolve().parent / \"output\"\u001b[8;1HOUTPUT_FILE = \"fibonacci_iterative_output.txt\"\u001b[11;1Hdef fib_sequence(count):\u001b[12;5H\"\"\"Return the first `count` Fibonacci numbers, built with a loop.\"\"\"\u001b[13;5Hsequence = []\u001b[14;5Ha, b = 0, 1\u001b[15;5Hfor _ in range(count):\u001b[16;9Hsequence.append(a)\u001b[17;9Ha, b = b, a + b\u001b[18;5Hreturn sequence\u001b[21;1Hdef fibonacci(count=25, filename=OUTPUT_FILE):\u001b[22;5H\"\"\"Write `count` Fibonacci numbers to `filename` in the output directory.\"\"\"\u001b[23;5Hsequence = fib_sequence(count)\u001b[25;5HOUTPUT_DIR.mkdir(exist_ok=True)\u001b[26;5Hpath = OUTPUT_DIR / filename\u001b[27;5Hwith open(path, \"w\") as f:\u001b[28;9Hfor index, value in enumerate(sequence):\u001b[29;13Hf.write(f\"F({index}) = {value"]
