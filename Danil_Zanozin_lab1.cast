[0.000, "o", "\u001b[20;1H\u001b[K\u001b[21;1Hdef fibonacci(count=25, filename=OUTPUT_FILE):\u001b[K\u001b[22;5H\"\"\"Write `count` Fibonacci numbers to `filename` in the output directory.\"\"\"\u001b[23;5Hsequence = fib_sequence(count)\u001b[24;5H\u001b[K\u001b[25;5HOUTPUT_DIR.mkdir(exist_ok=True)\u001b[26;5Hpath = OUTPUT_DIR / filename\u001b[27;5Hwith open(path, \"w\") as f:\u001b[K\u001b[28;9Hfor index, value in enumerate(sequence):\u001b[29;13Hf.write(f\"F({index}) = {value}\\n\")\u001b[30;5H\u001b[K\u001b[31;5Hprint(f\"Wrote {count} Fibonacci numbers to {path}\")\u001b[32;5Hreturn sequence\u001b[34;1H\u001b[K\u001b[35;1Hif __name__ == \"__main__\":\u001b[36;5Hfibonacci()\u001b[16;1H\u001b[16;2H\u001b[16;3H\u001b[16;4H\u001b[16;5H\u001b[16;6H\u001b[16;7H\u001b[16;8H\u001b[16;9Hreturn\u001b[16;16Hfib(n\u001b[16;22H-\u001b[16;24H1)\u001b[16;27H+"]
