[0.706, "o", "\u001b[32m==>\u001b[0m \u001b[1mCaveats\u001b[0m\r\n\u001b[34m==>\u001b[0m \u001b[1mopenssl@3\u001b[0m\r\n"]
[0.000, "o", "To add additional certificates, place .pem files in\r\n  /opt/homebrew/etc/openssl@3/certs\r\n\r\nand run\r\n  /opt/homebrew/opt/openssl@3/bin/c_rehash\r\n\r\nOpenSSL 3.6 is only supported until 2026-11-01 so the `openssl@3`\r\nformula will be downgraded to OpenSSL 3.5 (LTS) in a future update.\r\n"]
[0.000, "o", "\u001b[34m==>\u001b[0m \u001b[1mffmpeg\u001b[0m\r\nffmpeg-full includes additional tools and libraries that are not included in the regular ffmpeg formula.\r\n"]
[0.000, "o", "\u001b[34m==>\u001b[0m \u001b[1mgstreamer\u001b[0m\r\nAll gst-* GStreamer plugins are now bundled in this formula.\r\nFor GStreamer to find your own plugins, add their paths to `GST_PLUGIN_PATH`.\r\nFor example, if you have plugins in `~/.local/lib/gstreamer-1.0`:\r\n  export GST_PLUGIN_PATH=\"~/.local/lib/gstreamer-1.0\"\r\n\r\nDo not install plugins into GStreamer's prefix. They will be deleted\r\nby `brew upgrade`.\r\n"]
[0.387, "o", "\u001b[1m\u001b[7m%\u001b[27m\u001b[1m\u001b[0m                                                                                                                                                                                \r \r"]
[0.094, "o", "\r\u001b[0m\u001b[27m\u001b[24m\u001b[J(chessenv) danil@Danils-MacBook-Pro-3 pychess % \u001b[K"]
[0.001, "o", "\u001b[?2004h"]
[38.123, "o", "\u001b[7m$(brew --prefix python)/libexec/bin/python -m venv --system-site-packages chessenv\u001b[27m"]
[0.499, "o", "\u001b[82D\u001b[27m$\u001b[27m(\u001b[27mb\u001b[27mr\u001b[27me\u001b[27mw\u001b[27m \u001b[27m-\u001b[27m-\u001b[27mp\u001b[27mr\u001b[27me\u001b[27mf\u001b[27mi\u001b[27mx\u001b[27m \u001b[27mp\u001b[27my\u001b[27mt\u001b[27mh\u001b[27mo\u001b[27mn\u001b[27m)\u001b[27m/\u001b[27ml\u001b[27mi\u001b[27mb\u001b[27me\u001b[27mx\u001b[27me\u001b[27mc\u001b[27m/\u001b[27mb\u001b[27mi\u001b[27mn\u001b[27m/\u001b[27mp\u001b[27my\u001b[27mt\u001b[27mh\u001b[27mo\u001b[27mn\u001b[27m \u001b[27m-\u001b[27mm\u001b[27m \u001b[27mv\u001b[27me\u001b[27mn\u001b[27mv\u001b[27m \u001b[27m-\u001b[27m-\u001b[27ms\u001b[27my\u001b[27ms\u001b[27mt\u001b[27me\u001b[27mm\u001b[27m-\u001b[27ms\u001b[27mi\u001b[27mt\u001b[27me\u001b[27m-\u001b[27mp\u001b[27ma\u001b[27mc\u001b[27mk\u001b[27ma\u001b[27mg\u001b[27me\u001b[27ms\u001b[27m \u001b[27mc\u001b[27mh\u001b[27me\u001b[27ms\u001b[27ms\u001b[27me\u001b[27mn\u001b[27mv"]
